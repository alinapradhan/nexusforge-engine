{
  "info": {
    "name": "Universal Product Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"qa@example.com\",\"password\":\"Password123!\"}"
            },
            "url": "{{baseUrl}}/v1/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"qa@example.com\",\"password\":\"Password123!\"}"
            },
            "url": "{{baseUrl}}/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "Feed",
      "item": [
        {
          "name": "Create Session",
          "request": {
            "method": "POST",
            "header": [
              [
                "Authorization",
                "Bearer {{token}}"
              ]
            ],
            "url": "{{baseUrl}}/v1/feed/sessions"
          }
        },
        {
          "name": "Get Session",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/v1/feed/sessions/{{sessionId}}"
          }
        }
      ]
    }
  ]
}