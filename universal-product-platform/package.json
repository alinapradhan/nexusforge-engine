{
  "name": "nexusforge-engine",
  "version": "1.0.0",
  "private": true,
  "description": "NexusForge Engine — API-first digital product, catalog, subscription & analytics platform",
  "main": "src/server.js",
  "bin": {
    "nexusforge": "./bin/nexusforge.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node -e \"require('./database/store').seed(); console.log('Database seeded.')\"",
    "cli": "node bin/nexusforge.js",
    "test": "node --test tests/**/*.test.js src/**/*.test.js",
    "test:unit": "node --test tests/unit",
    "test:api": "node --test tests/api",
    "test:integration": "node --test tests/integration",
    "test:e2e": "node --test tests/e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.1.0"
  }
}
